{
  "manifest_version": 3,
  "name": "Booking Check Helper",
  "version": "0.1.0",
  "description": "Mở tab hãng tàu, điền booking và trả ETD / tàu / chuyến / POD cho Booking Check.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://booking-check-rho.vercel.app/*",
    "https://duynghiep89-sudo.github.io/*",
    "https://www.cma-cgm.com/*",
    "https://www.msc.com/*",
    "https://www.maersk.com/*",
    "https://elines.coscoshipping.com/*",
    "https://www.one-line.com/*",
    "https://ecomm.one-line.com/*",
    "https://www.zim.com/*",
    "https://ct.shipmentlink.com/*",
    "https://www.hapag-lloyd.com/*",
    "https://www.hmm21.com/*",
    "https://www.yangming.com/*",
    "https://www.sitcline.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://booking-check-rho.vercel.app/*",
        "https://duynghiep89-sudo.github.io/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Booking Check Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
